{
  "listen": "0.0.0.0:8080",
  "advertise": "http://leash:8080",
  "state_dir": "run",
  "sessions": ["chad-claude", "chad-codex"],

  "routes": {
    "anthropic": {
      "upstream": "https://api.anthropic.com",
      "credential": "env:ANTHROPIC_API_KEY",
      "inject": "anthropic",
      "paths": ["/v1/messages", "/v1/messages/count_tokens", "/v1/models", "/v1/models/*"],
      "meter": true
    },
    "openai": {
      "upstream": "https://api.openai.com",
      "credential": "env:OPENAI_API_KEY",
      "inject": "bearer",
      "paths": ["/v1/responses", "/v1/chat/completions", "/v1/models", "/v1/models/*"],
      "meter": true
    },
    "github": {
      "upstream": "https://github.com",
      "credential": "env:GITHUB_TOKEN",
      "inject": "basic:x-access-token",
      "paths": ["/*/info/refs", "/*/git-upload-pack", "/*/git-receive-pack"]
    }
  },

  "egress": {
    "allow": [
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "proxy.golang.org",
      "sum.golang.org",
      "objects.githubusercontent.com",
      "codeload.github.com"
    ],
    "ports": [443]
  },

  "spend": {
    "per_session_usd_per_day": 2.0,
    "total_usd_per_day": 10.0
  },

  "_prices_note": "USD per million tokens, [input, output], longest model-name prefix wins. Illustrative -- check current list prices before trusting a cap.",
  "prices_per_mtok": {
    "claude-opus": [5, 25],
    "claude-sonnet": [3, 15],
    "claude-haiku": [1, 5],
    "gpt-5": [1.25, 10],
    "default": [5, 25]
  }
}
