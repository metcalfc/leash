{
  "_note": "Spike policy: leash on the host's loopback, on 18080 (8080 is too commonly taken), reached from the VM only through QEMU's guestfwd at 10.0.2.100:8080. The cap is deliberately tiny so it trips on camera.",
  "listen": "127.0.0.1:18080",
  "advertise": "http://10.0.2.100:8080",
  "state_dir": "run",
  "sessions": ["demo"],

  "routes": {
    "anthropic": {
      "upstream": "https://api.anthropic.com",
      "credential": "env:ANTHROPIC_API_KEY",
      "inject": "anthropic",
      "paths": ["/v1/messages", "/v1/messages/count_tokens", "/v1/models", "/v1/models/*"],
      "meter": true
    },
    "github": {
      "upstream": "https://github.com",
      "credential": "env:GITHUB_TOKEN",
      "inject": "basic:x-access-token",
      "paths": ["/*/info/refs", "/*/git-upload-pack"]
    }
  },

  "egress": {
    "allow": [
      "pypi.org",
      "files.pythonhosted.org",
      "registry.npmjs.org"
    ],
    "ports": [443]
  },

  "spend": {
    "per_session_usd_per_day": 0.25
  },

  "prices_per_mtok": {
    "claude-opus": [5, 25],
    "claude-sonnet": [3, 15],
    "claude-haiku": [1, 5],
    "default": [5, 25]
  }
}
